{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "paths": {
      "@domain/*": ["./src/domain/*"],
      "infrastructure/*": ["./src/infrastructure/*"],
      "application/*": ["./src/application/*"]
    }
  }
}
